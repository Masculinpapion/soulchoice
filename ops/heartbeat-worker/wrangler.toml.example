name = "soulchoice-heartbeat"
main = "worker.js"
compatibility_date = "2026-01-01"

[triggers]
crons = ["*/10 * * * *"]

# KV namespace id `wrangler kv namespace create HB` çıktısından doldurulur (kurulum scripti yapar)
[[kv_namespaces]]
binding = "HB"
id = "<KV_ID — Cloudflare hesabında>"

# 20.09.2026: custom domain KULLANILMIYOR. SoulChoice altyapisi baska bir projenin
# DNS bolgesine BAGLANMAZ (20.09 arizasi). Erisim yalnizca workers.dev uzerinden:
#   https://soulchoice-heartbeat.mustafaaladag-ma.workers.dev
workers_dev = true
